{
  "S3Storage": {
    "BucketName": "",
    "KeyPrefix": "documents/uploads",
    "Region": "",
    "MaxFileSizeBytes": 1048576,
    "AllowedExtensions": [ ".txt", ".pdf", ".png", ".jpg", ".jpeg" ],
    "AllowedContentTypes": [ "text/plain", "application/pdf", "image/png", "image/jpeg" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
